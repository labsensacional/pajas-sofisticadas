rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "mathigatti@gmail.com";
    }

    // ── Community-submitted acciones ─────────────────────────
    match /acciones/{accionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.description is string;
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.reviewed == resource.data.reviewed);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
    }

    // ── Sesiones ─────────────────────────────────────────────
    match /sesiones/{sesionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string;
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }

    // ── Comments ─────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.parentId is string
        && request.resource.data.parentType is string;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ── Saves ────────────────────────────────────────────────
    match /saves/{saveId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.parentId is string
        && request.resource.data.parentType is string;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── Users ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt', 'themePreference', 'locale'])
        && (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName is string)
        && (!request.resource.data.keys().hasAny(['themePreference']) || request.resource.data.themePreference in ['system', 'light', 'dark'])
        && (!request.resource.data.keys().hasAny(['locale']) || request.resource.data.locale in ['es', 'en']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
