rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sesiones/{sesionId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /acciones/{accionId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
